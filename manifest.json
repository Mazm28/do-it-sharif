{
  "manifest_version": 3,
  "name": "Do It — Sharif",
  "version": "0.8.1",
  "description": "A simple to-do list for your courses, with assignments synced from CW and Quera.",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_title": "Do It",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "background": { "service_worker": "background.js" },
  "permissions": ["storage", "alarms", "notifications"],
  "host_permissions": ["https://cw.sharif.ir/*", "https://cw.sharif.edu/*", "https://quera.org/*", "https://www.google-analytics.com/*"]
}
